{
  "name": "noviscia-protocal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:integration": "tsx tests/integration.ts",
    "deploy": "anchor deploy",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "lint": "eslint . --ext .ts,.tsx",
    "setup:localnet": "bash scripts/setup/localnet.sh",
    "monitor:health": "bash scripts/monitor/health.sh",
    "sync:idls": "bash scripts/sync-idls.sh",
    "idl:upload-devnet": "bash scripts/upload-idl-devnet.sh",
    "verify:phase1": "tsx scripts/phase1_verify.ts",
    "verify:phase2": "tsx scripts/phase2_verify.ts",
    "verify:phase3": "tsx scripts/phase3_verify.ts",
    "verify:phase4": "tsx scripts/phase4_verify.ts",
    "verify:phase5": "tsx scripts/phase5_verify.ts",
    "verify:e2e": "tsx scripts/e2e_verify.ts",
    "init:devnet-rewire": "tsx scripts/init-rewire-devnet.ts",
    "init:perp-oracles": "tsx scripts/init-perp-oracles-devnet.ts",
    "init:phase1-devnet": "tsx scripts/init-phase1-devnet.ts",
    "init:phase2-devnet": "tsx scripts/init-phase2-devnet.ts",
    "init:native-insurance-devnet": "tsx scripts/init-native-insurance-devnet.ts",
    "migrate:pt-config-phase3-devnet": "tsx scripts/migrate-pt-config-phase3-devnet.ts",
    "migrate:pt-config-phase4-devnet": "tsx scripts/migrate-pt-config-phase4-devnet.ts",
    "migrate:oracle-state-v2-devnet": "tsx scripts/migrate-oracle-state-v2-devnet.ts",
    "migrate:devnet-pending": "tsx scripts/migrate-devnet-pending.ts",
    "set-oracle-pyth-feeds-devnet": "tsx scripts/set-oracle-pyth-feeds-devnet.ts",
    "configure:kamino-venue": "tsx scripts/configure-kamino-venue.ts",
    "bootstrap:kamino-devnet": "bash scripts/bootstrap-kamino-devnet.sh",
    "add:kamino-reserve-devnet": "cd app/web && npx tsx scripts/add-kamino-reserve-devnet.ts",
    "upgrade:lending-devnet": "bash scripts/upgrade-lending-devnet.sh",
    "upgrade:burn-devnet": "bash scripts/upgrade-burn-devnet.sh",
    "upgrade:position-tracker-devnet": "bash scripts/upgrade-position-tracker-devnet.sh",
    "upgrade:devnet-mocks": "bash scripts/upgrade-burn-devnet.sh && bash scripts/upgrade-lending-devnet.sh && bash scripts/upgrade-position-tracker-devnet.sh",
    "verify:kamino-devnet": "tsx scripts/verify-kamino-devnet.ts",
    "verify:kamino-recall-e2e": "tsx scripts/verify-kamino-recall-e2e.ts",
    "crank:kamino-once": "tsx scripts/crank-kamino-once.ts",
    "crank:burn-mock-once": "tsx scripts/crank-burn-mock-once.ts",
    "fund:burn-vault-nvsc": "tsx scripts/fund-burn-vault-nvsc.ts",
    "fix:kamino-reserve-oracle": "cd app/web && npx tsx scripts/fix-kamino-reserve-oracle-devnet.ts",
    "execute:limit-twap-devnet": "tsx scripts/executor/execute-limit-twap-devnet.ts",
    "init:nvsc-mint-devnet": "tsx scripts/init-nvsc-mint-devnet.ts",
    "setup:kamino-pool": "tsx scripts/run-kamino-setup-only.ts",
    "verify:burn-authority": "tsx scripts/verify-burn-authority-devnet.ts",
    "check:ai-layer": "tsx scripts/check-ai-layer.ts",
    "indexer:dev": "npm run dev --prefix services/indexer",
    "indexer:install": "npm install --prefix services/indexer",
    "indexer:railway": "bash scripts/indexer/deploy-railway.sh",
    "generate:doc-pdfs": "npm run generate:doc-pdfs --prefix app/web"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@pythnetwork/pyth-solana-receiver": "^0.8.2",
    "@solana/buffer-layout": "^4.0.1",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "redis": "^4.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^3.14.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "jito-ts": {
      "@solana/web3.js": {
        "rpc-websockets": "7.5.1"
      }
    }
  }
}
