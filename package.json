{
  "name": "noviscia-protocal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:integration": "tsx scripts/e2e/stress-tests-devnet.ts",
    "deploy": "anchor deploy",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "lint": "eslint . --ext .ts,.tsx",
    "setup:localnet": "bash scripts/setup/localnet.sh",
    "monitor:health": "bash scripts/monitor/health.sh",
    "sync:idls": "bash scripts/deploy/sync-idls.sh",
    "idl:upload-devnet": "bash scripts/deploy/upload-idl-devnet.sh",
    "init:devnet-rewire": "tsx scripts/init/init-rewire-devnet.ts",
    "init:perp-oracles": "tsx scripts/init/init-perp-oracles-devnet.ts",
    "init:phase1-devnet": "tsx scripts/init/init-phase1-devnet.ts",
    "init:phase2-devnet": "tsx scripts/init/init-phase2-devnet.ts",
    "init:native-insurance-devnet": "tsx scripts/init/init-native-insurance-devnet.ts",
    "init:nvsc-mint-devnet": "tsx scripts/init/init-nvsc-mint-devnet.ts",
    "migrate:pt-config-phase3-devnet": "tsx scripts/migrate/migrate-pt-config-phase3-devnet.ts",
    "migrate:pt-config-phase4-devnet": "tsx scripts/migrate/migrate-pt-config-phase4-devnet.ts",
    "migrate:oracle-state-v2-devnet": "tsx scripts/migrate/migrate-oracle-state-v2-devnet.ts",
    "migrate:devnet-pending": "tsx scripts/migrate/migrate-devnet-pending.ts",
    "set-oracle-pyth-feeds-devnet": "tsx scripts/init/set-oracle-pyth-feeds-devnet.ts",
    "upgrade:burn-devnet": "bash scripts/deploy/upgrade-burn-devnet.sh",
    "upgrade:position-tracker-devnet": "bash scripts/deploy/upgrade-position-tracker-devnet.sh",
    "upgrade:devnet-mocks": "bash scripts/deploy/upgrade-burn-devnet.sh && bash scripts/deploy/upgrade-position-tracker-devnet.sh",
    "crank:burn-mock-once": "tsx scripts/utils/crank-burn-mock-once.ts",
    "crank:oracle-refresh": "tsx scripts/utils/refresh-all-oracles-devnet.ts",
    "fund:burn-vault-nvsc": "tsx scripts/utils/fund-burn-vault-nvsc.ts",
    "execute:limit-twap-devnet": "tsx scripts/executor/execute-limit-twap-devnet.ts",
    "verify:burn-authority": "tsx scripts/monitor/verify-burn-authority-devnet.ts",
    "check:ai-layer": "tsx scripts/monitor/check-ai-layer.ts",
    "indexer:dev": "npm run dev --prefix services/indexer",
    "indexer:install": "npm install --prefix services/indexer",
    "indexer:railway": "bash scripts/indexer/deploy-railway.sh",
    "generate:doc-pdfs": "npm run generate:doc-pdfs --prefix app/web"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@pythnetwork/pyth-solana-receiver": "^0.8.2",
    "@solana/buffer-layout": "^4.0.1",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "1.95.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "redis": "^4.6.0",
    "rpc-websockets": "7.5.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "chai": "^6.2.2",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-mocha": "^11.1.0",
    "tsx": "^3.14.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "jito-ts": {
      "@solana/web3.js": {
        "rpc-websockets": "7.5.1"
      }
    }
  }
}
