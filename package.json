{
  "name": "noviscia-protocal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:integration": "tsx tests/integration.ts",
    "deploy": "anchor deploy",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:mainnet": "anchor deploy --provider.cluster mainnet",
    "lint": "eslint . --ext .ts,.tsx",
    "setup:localnet": "bash scripts/setup/localnet.sh",
    "monitor:health": "bash scripts/monitor/health.sh",
    "sync:idls": "bash scripts/sync-idls.sh",
    "verify:phase1": "tsx scripts/phase1_verify.ts",
    "verify:phase2": "tsx scripts/phase2_verify.ts",
    "verify:phase3": "tsx scripts/phase3_verify.ts",
    "verify:phase4": "tsx scripts/phase4_verify.ts",
    "verify:phase5": "tsx scripts/phase5_verify.ts",
    "verify:e2e": "tsx scripts/e2e_verify.ts",
    "init:devnet-rewire": "tsx scripts/init-rewire-devnet.ts",
    "init:perp-oracles": "tsx scripts/init-perp-oracles-devnet.ts",
    "init:phase1-devnet": "tsx scripts/init-phase1-devnet.ts",
    "check:ai-layer": "tsx scripts/check-ai-layer.ts",
    "keeper:dev": "npm run dev --prefix services/keeper",
    "keeper:start": "bash scripts/keeper/start-local.sh",
    "keeper:deploy": "bash scripts/keeper/deploy-docker.sh",
    "keeper:railway": "bash scripts/keeper/deploy-railway.sh",
    "generate:doc-pdfs": "npm run generate:doc-pdfs --prefix app/web"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/buffer-layout": "^4.0.1",
    "axios": "^1.6.0",
    "redis": "^4.6.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "tsx": "^3.14.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  }
}
